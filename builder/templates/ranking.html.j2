{% extends "base.html.j2" %}
{% block title %}今週のポイントUP額ランキング | ポイ活ニュース{% endblock %}
{% block description %}直近{{ up_days }}日間にポイントが増額され、現在も増額中の案件を増額幅（円換算）の大きい順に掲載。毎日自動更新。{% endblock %}
{% block canonical %}{{ base_url }}/ranking.html{% endblock %}
{% block jsonld %}
{# 日次で内容が入れ替わるランキングページ。CollectionPage＋dateModified で鮮度を機械可読に伝える #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "url": "{{ base_url }}/ranking.html",
      "name": {{ self.title() | tojson }},
      "description": {{ self.description() | tojson }},
      "isPartOf": { "@id": "{{ base_url }}/#website" },
      "inLanguage": "ja",
      "dateModified": "{{ updated_at_iso }}",
      "mainEntity": { "@id": "{{ base_url }}/ranking.html#itemlist" }
    },
    {# ランキングの中身（順位・案件名・リンク先）を機械可読に伝えるItemList。
       HTML肥大化（転送量増）を避けるため列挙は上位{{ jsonld_item_cap }}件に留める（numberOfItemsは全体数） #}
    {
      "@type": "ItemList",
      "@id": "{{ base_url }}/ranking.html#itemlist",
      "name": "今週のポイントUP額ランキング",
      "itemListOrder": "https://schema.org/ItemListOrderDescending",
      "numberOfItems": {{ rows | length }},
      "itemListElement": [{% for r in rows[:jsonld_item_cap] %}{{ "," if not loop.first }}
        { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ r.title | tojson }}, "url": {{ r.url | tojson }} }{% endfor %}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "{{ base_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "ポイントUP額ランキング", "item": "{{ base_url }}/ranking.html" }
      ]
    }
  ]
}
</script>
{% endblock %}
{% block header_meta %}
  <div class="meta">最終更新: {{ updated_at }}</div>
{% endblock %}
{% block content %}
{# 関連ページタブ: トップ・値動き履歴と行き来しやすくする（現在ページは塗りつぶし表示） #}
<nav class="jumpnav" aria-label="関連ページ">
  <a href="/">← ホーム</a>
  <a href="/ranking.html" class="current" aria-current="page">UP額ランキング</a>
  <a href="/popular.html">人気ランキング</a>
  <a href="/weekly.html">週間まとめ</a>
  <a href="/history.html">値動き履歴</a>
</nav>
<section>
  <h2>今週のポイントUP額ランキング<span class="allcount">（直近{{ up_days }}日）</span></h2>
  <p class="note">直近{{ up_days }}日間にポイントが増額され、今も増額中の案件を「増額幅（いくらUPしたか・円換算）」の大きい順に並べています。増額が終わった案件は自動的にランキングから外れます。</p>
  {% if rows %}
  <ol class="ranklist">
    {% for r in rows %}
    <li>
      <span class="rank">{{ loop.index }}</span>
      <span class="rankmeta"><span class="site">{{ site_names[r.site] if r.site in site_names else r.site }}</span><span class="posted">{{ r.up_date }}に増額</span></span>
      <span class="ttl"><a href="{{ r.url }}" rel="nofollow noopener" target="_blank">{{ r.title }}</a><span class="cat">{{ category_names[r.category] }}</span></span>
      <span class="vals"><s>{{ r.old_yen|yen }}円</s> → <strong>{{ r.new_yen|yen }}円</strong><span class="sub">（{{ r.points_text }}）</span></span>
      <span class="delta"><span class="delta-label">増額幅</span><span class="delta-val">+{{ r.diff|yen }}円</span></span>
    </li>
    {% endfor %}
  </ol>
  {% else %}
  <p class="empty">直近{{ up_days }}日間で増額を観測した案件はまだありません。</p>
  {% endif %}
  <p class="note">増額の検知は当サイトの掲載データの変化に基づきます。案件ごとの推移は<a href="/history.html">値動き履歴</a>で確認できます。</p>
</section>
{% endblock %}
